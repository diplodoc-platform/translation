{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "target": "es2022",
    "rootDir": "src",
    "outDir": "lib/",
    "module": "node16",
    "paths": {
      "src/*": ["./src/*"]
    },
    "moduleResolution": "node16"
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
